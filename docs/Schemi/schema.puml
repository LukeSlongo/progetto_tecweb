@startuml schema
hide circle
skinparam linetype ortho


entity "edificio" as edificio {
  * id : INT <<PK>>
  --
  * dipartimento_id : INT <<FK>>
  nome : VARCHAR(50) [UNIQUE]
  indirizzo : VARCHAR(255)
}

entity "aula" as aula {
  * id : INT <<PK>>
  --
  * edificio_id : INT <<FK>>
  nome : VARCHAR(50)
  piano : INT
}

entity "utente" as utente {
  * id : INT <<PK>>
  --
  nome_utente : VARCHAR(50)
  password : VARCHAR(255)
  ruolo : ENUM('studente', 'admin')
}

entity "segnalazione" as segnalazione {
  * id : INT <<PK>>
  --
  * utente_id : INT <<FK>>
  * aula_id : INT <<FK>>
  titolo : VARCHAR(150)
  descrizione : TEXT
  data_apertura : TIMESTAMP
  data_chiusura : TIMESTAMP [NULLABLE]
}

entity "preferiti" as preferiti {
  * utente_id : INT <<PK, FK>>
  * aula_id : INT <<PK, FK>>
  --
}

dipartimento ||--o{ edificio : "ha"

' Un edificio ha molte aule
edificio ||--o{ aula : "contiene"

' Un dipartimento ha molti utenti (tecnici/admin)
dipartimento ||--o{ utente : "impiega"

' Un utente (studente) crea molte segnalazioni
utente ||--o{ segnalazione : "apre"

' Un utente (tecnico) prende in carico molte segnalazioni
utente |o--o{ segnalazione : "risolve"

aula ||--o{ segnalazione : "riguarda"

utente ||--o{ preferiti
aula ||--o{ preferiti

@enduml